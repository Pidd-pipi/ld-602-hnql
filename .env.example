# Compose 项目与端口
COMPOSE_PROJECT_NAME=rescue-stock
FRONTEND_PORT=20102
BACKEND_PORT=21102

# 数据库（docker-compose 的 MySQL）
DB_PORT=33060
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db

# 临期物资管控闭环后端（backend/src，Node.js 零依赖）
PORT=21102
# 数据落盘文件：库存与放行记录的持久化来源，刷新/重启后一致
DATA_FILE=./backend/data/rescue-stock.json
# 临期阈值（天）：距到期日 ≤ 该天数的合格批次记为“临期”
NEAR_EXPIRY_DAYS=30
